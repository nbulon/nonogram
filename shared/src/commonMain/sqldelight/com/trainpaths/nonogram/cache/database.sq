CREATE TABLE NonogramData (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    difficulty TEXT NOT NULL,
    solution TEXT NOT NULL,
    authorUid TEXT NOT NULL DEFAULT '',
    status INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    name TEXT
);

CREATE TABLE User (
    uid TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL
);

CREATE TABLE UserProgress (
    userUid TEXT NOT NULL,
    nonogramId INTEGER NOT NULL,
    boardState TEXT,
    updatedAt INTEGER NOT NULL,
    beat INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (userUid, nonogramId),
    FOREIGN KEY (nonogramId) REFERENCES NonogramData(id)
);

upsertNonogram:
INSERT OR REPLACE INTO NonogramData(id, difficulty, solution, authorUid, status, updatedAt, name)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertSeedNonogram:
INSERT OR IGNORE INTO NonogramData(id, difficulty, solution, authorUid, status, updatedAt, name)
VALUES (?, ?, ?, ?, ?, ?, ?);

countNonograms:
SELECT count(*) FROM NonogramData;

updateNonogram:
UPDATE NonogramData
SET
    difficulty = :difficulty,
    solution = :solution,
    authorUid = :authorUid,
    status = :status,
    updatedAt = :updatedAt,
    name = :name
WHERE id = :id;


selectAllNonograms:
SELECT NonogramData.* FROM NonogramData;

selectNonogramsByDifficulty:
SELECT NonogramData.* FROM NonogramData WHERE difficulty = ?;

selectNonogramsByAuthor:
SELECT NonogramData.* FROM NonogramData WHERE authorUid = ?;

selectVisibleNonograms:
SELECT NonogramData.* FROM NonogramData
WHERE status = :approvedStatus OR authorUid = :authorUid;

selectPublishConflictId:
SELECT id FROM NonogramData
WHERE solution = :solution
  AND id != :excludeId
  AND (
      status = :approvedStatus
      OR (authorUid = :authorUid AND (status = :unlistedStatus OR status = :pendingStatus))
  )
LIMIT 1;

reassignAuthor:
UPDATE NonogramData SET authorUid = :toUid WHERE authorUid = :fromUid;

deleteNonogram:
DELETE FROM NonogramData WHERE id = :id;

deleteProgressForNonogram:
DELETE FROM UserProgress WHERE nonogramId = :id;

selectNonogramById:
SELECT NonogramData.* FROM NonogramData WHERE id = ?;

selectRandomNonogram:
SELECT NonogramData.* FROM NonogramData ORDER BY RANDOM() LIMIT 1;

selectRandomNonogramByDifficulty:
SELECT NonogramData.* FROM NonogramData WHERE difficulty = ? ORDER BY RANDOM() LIMIT 1;

upsertProgress:
INSERT OR REPLACE INTO UserProgress(userUid, nonogramId, boardState, updatedAt, beat)
VALUES (:userUid, :nonogramId, :boardState, :updatedAt, COALESCE((SELECT beat FROM UserProgress WHERE userUid = :userUid AND nonogramId = :nonogramId), 0));

upsertProgressAfterWin:
INSERT OR REPLACE INTO UserProgress(userUid, nonogramId, boardState, updatedAt, beat)
VALUES (:userUid, :nonogramId, NULL, :updatedAt, COALESCE((SELECT beat FROM UserProgress WHERE userUid = :userUid AND nonogramId = :nonogramId), 0) + 1);

selectProgressForUser:
SELECT NonogramData.*, UserProgress.boardState, UserProgress.beat
FROM NonogramData
JOIN UserProgress ON UserProgress.nonogramId = NonogramData.id
WHERE UserProgress.userUid = ?;

mergeProgressInto:
INSERT OR REPLACE INTO UserProgress(userUid, nonogramId, boardState, updatedAt, beat)
SELECT :toUid, src.nonogramId, src.boardState, src.updatedAt,
       max(src.beat, COALESCE((SELECT dst.beat FROM UserProgress dst
                               WHERE dst.userUid = :toUid AND dst.nonogramId = src.nonogramId), 0))
FROM UserProgress src
WHERE src.userUid = :fromUid
  AND src.updatedAt > COALESCE((SELECT dst.updatedAt FROM UserProgress dst
                                WHERE dst.userUid = :toUid AND dst.nonogramId = src.nonogramId), 0);

deleteProgressFor:
DELETE FROM UserProgress WHERE userUid = :uid;

upsertUser:
INSERT OR REPLACE INTO User(uid, name) VALUES (?, ?);

selectUser:
SELECT User.* FROM User WHERE uid = ?;

deleteUser:
DELETE FROM User WHERE uid = ?;

selectProgressForUserWithTimestamp:
SELECT UserProgress.nonogramId, UserProgress.boardState, UserProgress.updatedAt
FROM UserProgress
WHERE UserProgress.userUid = ?;

selectSingleProgress:
SELECT UserProgress.boardState, UserProgress.updatedAt
FROM UserProgress
WHERE UserProgress.userUid = ? AND UserProgress.nonogramId = ?;
